@inherits LayoutComponentBase
@inject StudyLifeApiClient Api

<div class="app-shell">
    <nav class="sidebar">
        <div class="brand">
            <span class="brand-icon">✦</span>
            <span class="brand-name">Developers</span>
        </div>
        <div class="nav-links">
            <span class="nav-item" style="cursor:default">
                <span class="nav-icon">@(Api.Connected ? "●" : "○")</span>
                <span class="nav-label">@(Api.Connected ? "Connected" : "Not connected")</span>
            </span>
            <AuthorizeView>
                @* Plain form POST with the antiforgery token, see PortalSignInEndpoints.LogoutAsync. *@
                <form method="post" action="@PortalSignInEndpoints.LogoutPath" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-item">
                        <span class="nav-icon">⇥</span>
                        <span class="nav-label">Sign out</span>
                    </button>
                </form>
            </AuthorizeView>
        </div>
    </nav>
    <main class="main-content">
        @Body
    </main>
</div>
